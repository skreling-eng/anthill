{
  "load_image": {
    "inputs": {
      "image": "INPUT_IMAGE"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Avatar portrait"
    }
  },
  "load_audio": {
    "inputs": {
      "audio": "INPUT_SOUND"
    },
    "class_type": "LoadAudio",
    "_meta": {
      "title": "Speech audio"
    }
  },
  "block_swap": {
    "inputs": {
      "blocks_to_swap": 0,
      "offload_img_emb": false,
      "offload_txt_emb": false,
      "use_non_blocking": true,
      "vace_blocks_to_swap": 0,
      "prefetch_blocks": 1,
      "block_swap_debug": false
    },
    "class_type": "WanVideoBlockSwap",
    "_meta": {
      "title": "Block swap"
    }
  },
  "wan_model": {
    "inputs": {
      "model": "Wan21-SkyReelsV3-A2V_fp8_scaled_mixed.safetensors",
      "base_precision": "fp16_fast",
      "quantization": "disabled",
      "load_device": "offload_device",
      "attention_mode": "sdpa",
      "rms_norm_function": "default",
      "block_swap_args": ["block_swap", 0]
    },
    "class_type": "WanVideoModelLoader",
    "_meta": {
      "title": "SkyReels V3 model"
    }
  },
  "vae_loader": {
    "inputs": {
      "model_name": "Wan2_1_VAE_bf16.safetensors",
      "precision": "bf16",
      "use_cpu_cache": false,
      "verbose": false
    },
    "class_type": "WanVideoVAELoader",
    "_meta": {
      "title": "Wan VAE"
    }
  },
  "wav2vec": {
    "inputs": {
      "model": "TencentGameMate/chinese-wav2vec2-base",
      "base_precision": "fp16",
      "load_device": "main_device"
    },
    "class_type": "DownloadAndLoadWav2VecModel",
    "_meta": {
      "title": "Wav2Vec"
    }
  },
  "multitalk_embeds": {
    "inputs": {
      "wav2vec_model": ["wav2vec", 0],
      "audio_1": ["load_audio", 0],
      "normalize_loudness": true,
      "num_frames": 400,
      "fps": 24,
      "audio_scale": 1,
      "audio_cfg_scale": 1,
      "multi_audio_type": "para",
      "add_noise_floor": false,
      "smooth_transients": false
    },
    "class_type": "MultiTalkWav2VecEmbeds",
    "_meta": {
      "title": "Audio embeds"
    }
  },
  "text_encode": {
    "inputs": {
      "model_name": "umt5-xxl-enc-bf16.safetensors",
      "precision": "bf16",
      "positive_prompt": "INPUT_PROMPT",
      "negative_prompt": "INPUT_NEG_PROMPT",
      "quantization": "disabled",
      "use_disk_cache": true,
      "device": "gpu"
    },
    "class_type": "WanVideoTextEncodeCached",
    "_meta": {
      "title": "Text encode"
    }
  },
  "skyreels_i2v": {
    "inputs": {
      "vae": ["vae_loader", 0],
      "start_image": ["load_image", 0],
      "width": 480,
      "height": 832,
      "frame_window_size": 81,
      "motion_frame": 5,
      "drop_frames": 12,
      "tiled_vae": false,
      "force_offload": true,
      "colormatch": "reinhard_torch"
    },
    "class_type": "WanVideoImageToVideoSkyreelsv3_audio",
    "_meta": {
      "title": "SkyReels A2V embeds"
    }
  },
  "scheduler": {
    "inputs": {
      "scheduler": "flowmatch_distill",
      "steps": 4,
      "shift": 5,
      "start_step": 0,
      "end_step": -1,
      "enhance_hf": false
    },
    "class_type": "WanVideoSchedulerv2",
    "_meta": {
      "title": "Scheduler"
    }
  },
  "extra_args": {
    "inputs": {
      "multitalk_embeds": ["multitalk_embeds", 0],
      "riflex_freq_index": 0,
      "rope_function": "comfy"
    },
    "class_type": "WanVideoSamplerExtraArgs",
    "_meta": {
      "title": "Sampler extra args"
    }
  },
  "sampler": {
    "inputs": {
      "model": ["wan_model", 0],
      "image_embeds": ["skyreels_i2v", 0],
      "scheduler": ["scheduler", 0],
      "text_embeds": ["text_encode", 0],
      "extra_args": ["extra_args", 0],
      "cfg": 1,
      "seed": "INPUT_SEED",
      "force_offload": true,
      "add_noise_to_samples": false
    },
    "class_type": "WanVideoSamplerv2",
    "_meta": {
      "title": "Sample"
    }
  },
  "pass_images": {
    "inputs": {
      "samples": ["sampler", 0]
    },
    "class_type": "WanVideoPassImagesFromSamples",
    "_meta": {
      "title": "Decode frames"
    }
  }
}

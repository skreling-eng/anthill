# Copy to .env on first setup (tools/init.ps1 does this automatically).
# Loaded by run_ah.py.

ACESTEP_BACKEND=native
ACESTEP_DEVICE=auto

# External venvs (from tools/setup_external_venvs.ps1)
AH_EXTERNAL_VENV_image=.venvs/media
AH_EXTERNAL_VENV_image2video=.venvs/media
AH_EXTERNAL_VENV_music=.venvs/music
AH_EXTERNAL_VENV_music_separation=.venvs/media
AH_EXTERNAL_VENV_change_voice=.venvs/change_voice
AH_EXTERNAL_VENV_text2speech=.venvs/text2speech
AH_EXTERNAL_VENV_voice_enhance=.venvs/voice_enhance

# Wan I2V aux paths (after tools/download_models.py --profile full)
WAN_I2V_BASE_DIR=wan/i2v-base
WAN_T2V_CONFIG_REPO=wan/Wan2.2-T2V-A14B-Diffusers

# Gated models (FLUX.1-dev) — create at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...

# $search / $serch — DuckDuckGo (no API key; optional locale override)
# AH_SERCH_KL=us-en
# AH_EMULATE_SERCH=1

# $image2text — Qwen2-VL (optional GPU; emulate for tests)
# AH_IMAGE2TEXT_GPU=1
# AH_EMULATE_IMAGE2TEXT=1
# AH_EXTERNAL_VENV_image2text=.venvs/media

# $image2image — Qwen-Rapid-AIO via diffusers (no ComfyUI)
# AH_IMAGE2IMAGE_WORKER=1   warm GPU worker (default; avoids ~28GB reload per job)
# AH_IMAGE2IMAGE_GPU=0
# AH_IMAGE2IMAGE_MIN_VRAM_GB=20
# AH_EMULATE_IMAGE2IMAGE=1
# AH_EXTERNAL_VENV_image2image=.venvs/media

# Optional overrides
# ACESTEP_CHECKPOINTS_DIR=models/ace-step-1.5_st
# ANTHILL_HF_REPO_ID=skreling-eng/anthill

# Copy to .env on first setup (tools/init.ps1 or tools/init.sh does this automatically).
# Loaded by run_ah.py.

ACESTEP_BACKEND=native
ACESTEP_DEVICE=auto

# External venvs (from tools/setup_external_venvs.ps1)
AH_EXTERNAL_VENV_image=.venvs/media
AH_EXTERNAL_VENV_image2image=.venvs/media
AH_EXTERNAL_VENV_image2video=.venvs/comfy-wan
# AH_EXTERNAL_VENV_image2video=.venvs/media   # lighter venv without vendored custom-node deps
AH_EXTERNAL_VENV_music=.venvs/music
AH_EXTERNAL_VENV_music_separation=.venvs/media
AH_EXTERNAL_VENV_change_voice=.venvs/change_voice
AH_EXTERNAL_VENV_text2speech=.venvs/text2speech
AH_EXTERNAL_VENV_voice_enhance=.venvs/voice_enhance
AH_EXTERNAL_VENV_openpose=.venvs/media
AH_EXTERNAL_VENV_canny=.venvs/media
AH_EXTERNAL_VENV_depth=.venvs/media
AH_EXTERNAL_VENV_controlnet=.venvs/media
# $controlnet — Qwen-Image FP8 + Union ControlNet (comfy-kitchen in .venvs/media; no ComfyUI python)
# AH_CONTROLNET_VRAM=low
# AH_CONTROLNET_MAX_AREA=589824
# AH_EMULATE_CONTROLNET=1

# Wan I2V aux paths (after tools/download_models.py --profile full)
WAN_I2V_BASE_DIR=wan/i2v-base
WAN_T2V_CONFIG_REPO=wan/Wan2.2-T2V-A14B-Diffusers

# Gated models (FLUX.1-dev) — create at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...

# $search ($serch alias) — DuckDuckGo (no API key; optional locale override)
# AH_SERCH_KL=us-en
# AH_EMULATE_SERCH=1

# $image2text — Qwen VL (GPU when CUDA available; emulate for tests)
# AH_IMAGE2TEXT_GPU=0
# AH_EMULATE_IMAGE2TEXT=1
# AH_EXTERNAL_VENV_image2text=.venvs/media
# AH_EXTERNAL_VENV_image2embedding=.venvs/media
# AH_EXTERNAL_VENV_text2embedding=.venvs/media
# AH_EXTERNAL_VENV_video2embedding=.venvs/media
AH_EXTERNAL_VENV_split_video=.venvs/media
AH_EXTERNAL_VENV_split_video_fast=.venvs/media
AH_EXTERNAL_VENV_create_video_index=.venvs/media
AH_EXTERNAL_VENV_search_local_video=.venvs/media
AH_EXTERNAL_VENV_add_video_embedding_files=.venvs/media

# $image2image — Qwen-Rapid-AIO via comfy_lib (.venvs/media warm worker; comfy-kitchen for FP8)
# AH_IMAGE2IMAGE_WORKER=1   warm GPU worker (default; avoids ~28GB reload per job)
# AH_IMAGE2IMAGE_GPU=0
# AH_IMAGE2IMAGE_VRAM=normal  default on <32GB GPU (19GB UNet needs activations headroom)
# AH_IMAGE2IMAGE_VRAM=high    only if 32GB+ VRAM; ignores WAN_I2V_VRAM. low|novram if OOM
# AH_IMAGE2IMAGE_SAMPLER=euler   optional; workflow uses sa_solver
# AH_IMAGE2IMAGE_MIN_VRAM_GB=20
# AH_EMULATE_IMAGE2IMAGE=1

# In-process comfy_lib: load only required comfy_extras (default). Set 1 to load all (needs comfy_api).
# AH_COMFY_LOAD_ALL_EXTRAS=0
# AH_COMFY_WAN_WRAPPER=0   disable ComfyUI-WanVideoWrapper import (default on for $image2video)
# AH_COMFY_MEMORY=1       unload GPU between MEGA/VACE nodes (ComfyUI-like; default on for WanVaceToVideo)
# AH_COMFY_EXECUTOR=comfy   force vendored PromptExecutor (default: legacy for Qwen i2i, comfy for MEGA/VACE)
# AH_COMFY_CACHE=classic    node output cache for PromptExecutor (none|lru)
# Warm worker Python: defaults to .venvs/comfy-wan (media + WanVideoWrapper/VHS deps)
# 16GB GPU: MEGA may auto-set WAN_I2V_VRAM=novram; resolution/frame caps are opt-in only
# WAN_I2V_TILED_VAE=1   tiled VAE encode/decode (or $image2video(..., tiled_vae=1))
# WAN_I2V_TILED_VAE_FULL=1   force full VAE on GPU with tiled mode (off by default; Comfy-like)
# WAN_I2V_VRAM=novram    recommended for MEGA on ~16GB; low if you have headroom
# WAN_I2V_FRAMES=25      manual frame override (WAN_I2V_NO_FRAME_CAP=1 disables auto frame cap)
# WAN_I2V_AUTO_CAP=1     opt-in: shrink width/height/frames on ≤18GB (off by default)
# WAN_I2V_NO_FRAME_CAP=1 with AUTO_CAP=1: keep resolution cap but not frame cap
# WAN_I2V_MAX_AREA=983040  with AUTO_CAP=1: cap area at ~768×1280
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# $image2video — Wan MEGA I2V via comfy_lib (default) or diffusers
# AH_IMAGE2VIDEO_WORKER=1   warm GPU worker (default; avoids ~22GB reload per job)
# AH_IMAGE2VIDEO_BACKEND=comfy_lib   in-process Comfy (default)
# AH_IMAGE2VIDEO_BACKEND=diffusers   diffusers Wan path
# AH_IMAGE2VIDEO_BACKEND=comfy        ComfyUI HTTP API
# AH_EMULATE_IMAGE2VIDEO=1
# AH_EXTERNAL_VENV_image2video=.venvs/media
# ACESTEP_CHECKPOINTS_DIR=models/ace-step-1.5_st
# ANTHILL_HF_REPO_ID=skreling-eng/anthill
